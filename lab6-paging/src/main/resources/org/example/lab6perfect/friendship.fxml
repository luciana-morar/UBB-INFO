<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.lab6perfect.controller.FriendshipController"
      spacing="15">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Gestionare Prietenii"
           style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <HBox spacing="20">

        <VBox spacing="10">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Prietenii Existenti" style="-fx-font-weight: bold;"/>
                <Button text="Sterge Prietenie"
                        onAction="#removeSelectedFriendship"
                        style="-fx-background-color: #F44336; -fx-text-fill: white;"/>
                <Button text="Reincarca" onAction="#refreshAll"/>
            </HBox>

            <TableView fx:id="friendshipTable" prefHeight="400">
                <columns>
                    <TableColumn fx:id="colFriendUser1" text="Utilizator 1" prefWidth="150"/>
                    <TableColumn fx:id="colFriendUser2" text="Utilizator 2" prefWidth="150"/>
                </columns>
            </TableView>
        </VBox>

        <VBox spacing="10" prefWidth="300">
            <Label text="Adauga Prietenie Noua" style="-fx-font-weight: bold;"/>

            <GridPane hgap="10" vgap="10">
                <Label text="Username 1:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="friend1Field" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Username 2:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="friend2Field" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            </GridPane>

            <HBox spacing="10">
                <Button text="Adauga Prietenie"
                        onAction="#addFriendship"
                        style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
                <Button text="Curata" onAction="#clearForm"/>
            </HBox>
        </VBox>

    </HBox>
</VBox>

