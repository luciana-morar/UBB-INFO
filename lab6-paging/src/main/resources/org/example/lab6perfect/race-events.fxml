<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.lab6perfect.controller.RaceEventController"
      spacing="10"
      style="-fx-background-color: #f5f5f5;">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <HBox spacing="10">
        <Label text="Race Events" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Refresh" onAction="#handleRefresh"
                style="-fx-padding: 5 10 5 10;"/>
    </HBox>

   <VBox spacing="8" style="-fx-background-color: white; -fx-padding: 10; -fx-border-radius: 5;">
        <Label text="Create New Race Event" style="-fx-font-weight: bold;"/>

        <HBox spacing="10">
            <VBox spacing="5">
                <Label text="Name:"/>
                <TextField fx:id="eventNameField" prefWidth="150"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Distances:"/>
                <TextField fx:id="distancesField" prefWidth="150" promptText="50,100,200"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Lanes:"/>
                <TextField fx:id="lanesField" prefWidth="60"/>
            </VBox>

            <VBox spacing="5">
                <Label text=" " style="-fx-opacity: 0;"/>
                <Button fx:id="createEventButton" text="Create" onAction="#handleCreateEvent"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 5 15 5 15;"/>
            </VBox>
        </HBox>
    </VBox>

    <HBox spacing="10" VBox.vgrow="ALWAYS">

        <VBox spacing="5" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 10; -fx-border-radius: 5;">
            <Label text="All Race Events" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
            <TableView fx:id="eventTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colEventId" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="colEventName" text="Event Name" prefWidth="200"/>
                    <TableColumn fx:id="colLanes" text="Lanes" prefWidth="80"/>
                    <TableColumn fx:id="colParticipants" text="Participants" prefWidth="100"/>
                </columns>
            </TableView>
        </VBox>

        <VBox spacing="5" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 10; -fx-border-radius: 5;">
            <HBox>
                <Label text="Participants" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="selectedEventLabel" text="No event selected"
                       style="-fx-font-weight: bold; -fx-text-fill: #3498db;"/>
            </HBox>
            <ListView fx:id="participantsList" VBox.vgrow="ALWAYS"/>
        </VBox>
    </HBox>

    <VBox spacing="8" style="-fx-background-color: white; -fx-padding: 10; -fx-border-radius: 5;">
        <HBox spacing="5">
            <Button fx:id="registerButton" text="Register" onAction="#handleRegister"
                    style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-padding: 5 15 5 15;"/>
            <Button fx:id="unregisterButton" text="Unregister" onAction="#handleUnregister"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-padding: 5 15 5 15;"/>
            <Button fx:id="startRaceButton" text="Start Race" onAction="#handleStartRace"
                    style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-padding: 5 15 5 15;"/>
            <Button fx:id="deleteEventButton" text="Delete" onAction="#handleDeleteEvent"
                    style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-padding: 5 15 5 15;"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </VBox>


    <VBox spacing="8" visible="false" fx:id="raceProgressSection"
          style="-fx-background-color: #fff3cd; -fx-padding: 10; -fx-border-radius: 5;">
        <Label text="Race in Progress" style="-fx-font-weight: bold;"/>
        <ProgressBar fx:id="raceProgressBar" prefWidth="450"/>
        <Label fx:id="raceStatusLabel" text="Starting race..."/>
        <TextArea fx:id="raceLogTextArea" prefHeight="300" prefWidth="600" editable="false"/>
    </VBox>

    <VBox spacing="8" visible="false" fx:id="messageSection"
          style="-fx-background-color: #e8f4fd; -fx-padding: 10; -fx-border-radius: 5;">
        <Label text="Send Message to Participants" style="-fx-font-weight: bold;"/>
        <TextArea fx:id="messageTextArea" prefHeight="60" promptText="Type your message here..."/>
        <HBox spacing="5">
            <Button text="Send Message" onAction="#handleSendMessage"
                    style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-padding: 5 10 5 10;"/>
            <Button text="Simulate Race" onAction="#handleSimulateRace"
                    style="-fx-background-color: #1abc9c; -fx-text-fill: white; -fx-padding: 5 10 5 10;"/>
        </HBox>
    </VBox>

    <Label fx:id="statusLabel" text="Ready" style="-fx-text-fill: #666;"/>

</VBox>
